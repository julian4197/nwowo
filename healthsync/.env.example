# Nur für den ersten Login nötig. Danach reichen die gespeicherten Tokens,
# und du kannst Passwort hier wieder löschen.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Ziel für die Tageszusammenfassung (rclone-Remote:Ordner)
# gdrive: wenn das Remote per root_folder_id auf den Ordner Workout-Coach zeigt
RCLONE_REMOTE=gdrive:
SYNC_TIMES=07:30,13:00,21:30
SYNC_DAYS=3
# Port für das Dashboard (http://<NAS-IP>:8085/) und den optionalen Empfang
# für die iPhone-App Health Auto Export
HAE_PORT=8085
# Beliebiges langes Zufallswort, in der App als Header X-Token eintragen
HAE_TOKEN=
# Wie oft plan.json aus Google Drive geprüft und zu Garmin geschickt wird (0 = aus)
PLAN_CHECK_MINUTES=15
# iCloud-Kalender (für Trainingsplanung um Termine herum).
# App-spezifisches Passwort unter https://account.apple.com -> Anmeldung & Sicherheit
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# Kommagetrennte Kalendernamen, leer = alle
ICLOUD_CALENDARS=
CALENDAR_DAYS=14
# Gewicht und Ernährung aus dem HealthFit-Google-Sheet (ID aus der Sheet-URL).
# Ersetzt Health Auto Export. rclone braucht dafür scope = drive.
HEALTHFIT_SHEET_ID=
# Name für die Begrüßung im Dashboard (optional)
DASHBOARD_NAME=
